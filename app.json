{
  "expo": {
    "name": "E-Budget",
    "slug": "e-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tabIcons/e-budget.png",
    "scheme": "e-budget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tabIcons/e-budget.png",
      "bundleIdentifier": "com.anonymous.ebudget"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tabIcons/e-budget-foreground.png",
        "backgroundColor": "#0B1220"
      },
      "package": "com.anonymous.ebudget"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tabIcons/e-budget.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tabIcons/e-budget.png",
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cabfecd-037b-407f-a35a-7069bfc5595d"
      }
    }
  }
}