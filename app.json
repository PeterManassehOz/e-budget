{
  "expo": {
    "name": "E-Budget",
    "slug": "e-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tabIcons/e-budget.jpg",
    "scheme": "e-budget",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/tabIcons/e-budget.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "icon": "./assets/images/tabIcons/e-budget.jpg",
      "bundleIdentifier": "com.anonymous.ebudget"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tabIcons/e-budget-foreground.png",
        "backgroundColor": "#0B1220"
      },
      "package": "com.anonymous.ebudget"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tabIcons/e-budget.jpg"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
